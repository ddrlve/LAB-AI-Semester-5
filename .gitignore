!LAB Deep Learning/session-*/models/.gitkeep
LAB Speech Recognition/session-*/models/*
!LAB Speech Recognition/session-*/models/.gitkeep

# Outputs per session (hasil training, plots, dsb — biasanya reproducible)
LAB Deep Learning/session-*/outputs/*
!LAB Deep Learning/session-*/outputs/.gitkeep
LAB Speech Recognition/session-*/outputs/*
!LAB Speech Recognition/session-*/outputs/.gitkeep
